{
  "devDependencies": {
    "jest": "^30.3.0"
  },
  "name": "root-project",
  "scripts": {
    "test:frontend": "npm --prefix client test",
    "test:backend": "npm --prefix server test",
    "coverage:frontend": "npm --prefix client test -- --coverageDirectory=coverage",
    "coverage:backend": "npm --prefix server test -- --coverageDirectory=coverage",
    "test:all": "npm run test:backend && npm run test:frontend",
    "coverage:all": "npm run coverage:backend && npm run coverage:frontend"
  }
}
